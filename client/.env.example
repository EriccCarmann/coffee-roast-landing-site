# Copy to .env.local (never commit it). On the host, add the same names in its
# "Environment variables" settings.

# Telegram: 1) talk to @BotFather -> /newbot -> copy the token
#           2) send any message to your bot, then open
#              https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to true after running `npm run images` to serve images from /public/images.
# NEXT_PUBLIC_ means "also visible in the browser" (that is how Next.js marks it).
NEXT_PUBLIC_LOCAL_IMAGES=false
